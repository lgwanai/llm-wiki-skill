# Wiki pipeline configuration — EXAMPLE FILE
# Copy to wiki_config.yaml and fill in your own keys:
#   cp scripts/wiki_config.yaml.example scripts/wiki_config.yaml
#
# wiki_config.yaml is in .gitignore — never commit real keys to git.

# OCR: local DeepSeek-OCR service for document processing (PDF, images)
# Replace with your own OCR service URL and API key
ocr:
  api_url: "http://127.0.0.1:12345/v1/chat/completions"
  api_key: "your-ocr-api-key-here"
  model: "DeepSeek-OCR-4bit"
  pdf_dpi: 150

# LLM: remote API for entity extraction and knowledge compilation
# Replace with your own provider, API key, and model
llm:
  api_key: "sk-your-api-key-here"
  base_url: "https://api.deepseek.com"
  model: "deepseek-v4-flash"
  temperature: 0.3

# ReaderLM: HTML-to-Markdown conversion service (used by url2markdown.py)
# Same server as OCR typically, different model
readerlm:
  api_base: "http://127.0.0.1:12345"
  api_key: "your-readerlm-api-key-here"
  model: "jinaai-ReaderLM-v2"
