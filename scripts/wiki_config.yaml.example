# LLM Wiki v2 configuration
# Copy to wiki_config.yaml and edit the values you actually need.

# Wiki data directory. Relative paths are resolved from the current project root.
wiki_dir: .wiki

# Compile defaults to Agent mode. The current Agent reads sources, decides the
# source type, and writes wiki pages according to schema.md. No model/API key is
# required unless you explicitly run `wiki compile --mode llm`.
compile:
  mode: agent

# Optional chat model used for `wiki compile --mode llm`, query synthesis, or ledger ask.
# provider: deepseek | openai | ollama | custom
model:
  provider: deepseek
  model: deepseek-v4-flash
  api_key: ${DEEPSEEK_API_KEY}
  base_url: https://api.deepseek.com
  temperature: 0.3
  max_tokens: 32000

  # Ollama example:
  # provider: ollama
  # model: llama3.2
  # base_url: http://localhost:11434
  # num_ctx: 32768

  # Custom OpenAI-compatible endpoint:
  # provider: custom
  # api_url: http://localhost:8000/v1/chat/completions
  # api_key: ${LLM_API_KEY}

# Optional reranker for experimental/benchmark retrieval.
# LLM Wiki is designed to compile knowledge into pages first; rerankers are
# disabled by default because they add model cost without improving the wiki
# itself.
# backend:
#   flagembedding  — Cross-encoder via FlagEmbedding (BGE/Qwen3-Reranker, PyTorch)
#   mlx            — Apple Silicon embedding model (bi-encoder, lower accuracy)
#                     NOTE: MLX models are missing lm_head; they work as bi-encoders
#                     and are NOT recommended as the primary reranker.
#   auto           — Auto-detect
reranker:
  enabled: false                          # enable when model is available
  backend: flagembedding                  # flagembedding | mlx | auto
  model: Qwen/Qwen3-Reranker-0.6B        # 0.6B cross-encoder (or 8B for MLX)

query:
  llm_synthesis: true
  synthesis_mode: agent             # agent (default, no configured LLM) | llm
  default_format: markdown
  max_results: 5
  parallel_search: true
  # Default is wiki-native: frontmatter metadata + page BM25 + compiled graph + ledgers.
  # Optional legacy/RAG-like streams can be enabled explicitly:
  # metadata,bm25,graph,ledger,chunk,vector,chunk_vector
  search_streams: metadata,bm25,graph,ledger
  llm_query_expansion: false
  verify_answers: true

# OCR is optional. Local mode uses one backend; API mode uses an
# OpenAI-compatible vision endpoint or a provider preset.
ocr:
  mode: local              # local | api
  backend: ovis            # ovis | mineru | deepseek | logics | paddle

  # Backend-specific local options. Change only when needed.
  options:
    project_path: /Users/wuliang/workspace/OvisOCR2
    python_path: /Users/wuliang/workspace/OvisOCR2/.venv/bin/python
    model_path: /Users/wuliang/workspace/OvisOCR2/models/OvisOCR2-MLX-4bit
    dpi: 200
    max_tokens: 8192
    crop_padding_x: 0
    crop_padding_y: 0

  # API OCR example:
  # mode: api
  # api_provider: siliconflow
  # api_key: ${SILICONFLOW_API_KEY}
  # api_model: deepseek-ai/DeepSeek-OCR
  # api_url: https://api.siliconflow.cn/v1/chat/completions
  # api_prompt: "<image>\n<|grounding|>OCR this image."
  pdf_dpi: 200

# Optional image understanding for `wiki compile <image-or-directory>`.
# When enabled, images are first analyzed by a VL/omni model; OCR can then
# add dense text extraction for screenshots or document images.
#
# NOTE: This Python-side vision API is only used in `--mode llm`. Default agent
# mode runs the configured OCR backend first.
image_analysis:
  enabled: false
  api_provider: ""         # siliconflow | openai | deepseek | paddleocr-vl
  api_url: ""              # optional OpenAI-compatible /v1/chat/completions endpoint
  api_key: ""              # e.g. ${OPENAI_API_KEY} or ${SILICONFLOW_API_KEY}
  api_model: ""            # e.g. gpt-4o, qwen-vl, deepseek-vl, PaddleOCR-VL
  ocr_fallback: true
  ocr_min_chars: 800

# vision-skill is only the fallback after configured OCR fails or returns
# insufficient document text. It must not replace successful OvisOCR2 output.
vision_skill:
  enabled: true                                # fallback enabled; OCR still always runs first
  scripts_path: ""                             # dir containing vision_cli.py; empty = invoke skill by name only
  recognize_format: markdown_note              # vision_cli --format preset (markdown_note | ocr | analysis | ...)

# Optional Zvec semantic stream. Install with: pip install -e '.[vector]'
embeddings:
  enabled: false
  backend: zvec
  model_source: modelscope       # Chinese-friendly local default; dimension auto-detected
  index_path: graph/zvec
  optimize: true

quality:
  auto_heal: true
  min_score: 0.4

logging:
  level: INFO
