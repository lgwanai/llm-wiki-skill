# Wiki configuration — the single canonical config file
#   scripts/wiki_config.yaml (this file)
#
# Copy from the template if you don't have one:
#   cp scripts/wiki_config.yaml.example scripts/wiki_config.yaml
#
# wiki_config.yaml is in .gitignore — never commit real keys.

# --- Pipeline backends ---

# MinerU (default) — high-precision document parsing
# Backends: pipeline (CPU, 85+ accuracy) | hybrid-auto-engine (GPU, 95+)
mineru:
  backend: pipeline            # pipeline | hybrid-auto-engine | vlm-auto-engine
  lang: ch                     # ch | en | korean | japan | ...
  method: auto                 # auto | txt | ocr
  formula: true                # Formula → LaTeX
  table: true                  # Table → HTML
  start_page:                  # Optional: start page (0-indexed)
  timeout: 600                 # CLI timeout in seconds

# PaddleOCR — PP-OCRv5 text recognition, 109 languages, doc unwarping
paddleocr:
  lang: ch                     # ch | en | korean | japan | ...
  use_doc_orientation_classify: true   # Auto-rotate skewed documents
  use_doc_unwarping: true              # Fix warped/curved pages
  text_det_thresh: 0.3
  text_rec_score_thresh: 0.5

# DeepSeek-OCR — grounding + text extraction via API
ocr:
  api_url: "http://127.0.0.1:12345/v1/chat/completions"
  api_key: "your-ocr-api-key"
  model: "DeepSeek-OCR-4bit"
  pdf_dpi: 150

llm:
  provider: deepseek
  api_key: "your-llm-api-key"
  base_url: "https://api.deepseek.com"
  model: "deepseek-v4-flash"
  temperature: 0.3

# --- Wiki behavior ---

hooks:
  on_new_source: {enabled: true, auto_ingest: true}
  on_session_end: {enabled: true, auto_crystallize: true}

retention:
  architecture: {half_life_days: 180}
  project: {half_life_days: 130}
  bug: {half_life_days: 20}
  meeting: {half_life_days: 10}
  pattern: {half_life_days: 87}
  preference: {half_life_days: 527}

quality:
  auto_heal: true
  min_score: 0.4

query:
  llm_synthesis: true         # LLM synthesis (true=full answer, false=raw search results)

# --- Optional production-scale backends ---
